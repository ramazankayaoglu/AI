import math
def get_position_encodding(context_length, embedding_dimension, base = 10000, device = "cpu"):
    p_embeddings = torch.zeros(context_length, embedding_dimension, device = device)
    for pos in range(context_length):
        for i in range(embedding_dimension // 2):
            p_embeddings[pos, 2 * i] = math.sin(pos / (base ** (2 * i / embedding_dimension)))
            if(i + 1 < embedding_dimension):
                p_embeddings[pos, 2 * i + 1] = math.cos(pos / (base ** ((2 * i + 1) / embedding_dimension)))
    
    return p_embeddings.unsqueeze(0)


